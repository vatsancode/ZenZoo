PORT=4000
# Must connect as app_role, never a superuser - RLS is app_role's only
# access boundary and a superuser bypasses it silently. See
# docs/db-design.md's "Row-level security" and prisma/README.md.
DATABASE_URL="postgresql://app_role:app_role_dev_password@localhost:5432/zenzoo_dev"
# Signs session JWTs issued by POST /auth/sign-in. Generate your own per
# environment, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
JWT_SECRET="replace-with-a-random-secret"
