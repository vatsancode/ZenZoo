; Keep pnpm's default (isolated, symlinked) node_modules layout everywhere.
; apps/pos's metro.config.js is set up for this explicitly (watchFolders +
; nodeModulesPaths) rather than forcing a repo-wide hoisted layout, which
; would risk silently collapsing the admin app's React 19 and the POS app's
; React Native-pinned React onto a single hoisted version.
auto-install-peers=true
strict-peer-dependencies=false
; React Native/Expo packages are not always strict about declaring every
; peer they expect from the host app; this keeps pnpm from hard-failing
; installs over that rather than hiding real workspace dependency problems.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
; Admin (React 19) and POS (React 18.3.1, via Expo/React Native) legitimately
; need two different @types/react(-dom) versions. pnpm's shared internal
; hoist folder (node_modules/.pnpm/node_modules) can only hold one of them,
; which is ambiguous and was being resolved to the wrong version when
; type-checking expo-router/@react-navigation's .d.ts files (they reference
; "react" types but don't declare @types/react themselves). Excluding these
; from that shared hoist forces Node's directory-walk resolution to fall
; through to each app's own, correctly-pinned node_modules/@types/react.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
